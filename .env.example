# These settings configure contribution-reports tools. Copy .env.example to
# .env, or point to it via the `WS_ENV_FILE` environment variable.
#
# The tools resolve environment files in this order: `--env-file`, then
# `WS_ENV_FILE`, then the nearest `.env` found while walking up from the
# current directory. Shell variables starting with `WS_*` override values in
# this file.

# Base URL for the OSM API. All element and changeset fetches route through it.
#
# Live fetches require this value. For production, we might use:
# https://api.workspaces.sidewalks.washington.edu/api/v1/
#
WS_OSM_URL=https://api.workspaces.sidewalks.washington.edu/api/v1/

# Workspaces API to fetch quest definitions and workspace metadata from:
#
WS_NEW_API_URL=https://api.workspaces.sidewalks.washington.edu/api/v1/

# We can provide a TDEI access token here to skip interactive authentication:
#
WS_REPORT_TOKEN=

# TDEI backend URL used to fetch access tokens if we haven't set
# `WS_REPORT_TOKEN`:
#
WS_TDEI_BACKEND_URL=https://portal-api.tdei.us/api/v1/

# Username for auth with `WS_TDEI_BACKEND_URL`. If we leave this empty, the
# process falls back to an interactive prompt:
#
WS_REPORT_USER=

# Password for auth `WS_REPORT_USER`. If we leave it blank, the script prompts
# us interactively:
#
WS_REPORT_PASS=

# We'll need this key when we use `--infer-issues` with the default `anthropic`
# provider. We don't need it for `openai` or `ollama` providers.
#
# If we leave this absent, the report renders without an issues panel because
# inference is skipped.
#
WS_ANTHROPIC_API_KEY=

# LLM provider for `--infer-issues`:
#
#  - anthropic (default)
#  - ollama
#  - openai
#
WS_LLM_PROVIDER=

# LLM model for `--infer-issues`. For `anthropic`, this defaults to
# claude-sonnet-5.
#
# For ollama or openai providers, we can use any model served by the target
# server, but we need to specify it through this variable or `--llm-model`.
#
WS_LLM_MODEL=

# Model server's base URL for the `openai` and `ollama` providers.
#
# We need to set this for `openai`, though we may omit the `/v1` suffix.
#
WS_LLM_URL=

# URL for the `ollama` provider if we leave `WS_LLM_URL` unset (default:
# http://localhost:11434):
#
WS_OLLAMA_URL=

# Overpass API base URL. It defaults to https://overpass-api.de/api/interpreter,
# but we might override this value to use a local mirror.
#
WS_OVERPASS_URL=

# We include this bearer token in the Authorization header when Overpass
# mirrors require authentication.
#
WS_OVERPASS_TOKEN=

# Comma-separated changeset `created_by` prefixes that override the built-in
# survey-app list, which contains "AVIV ScoutRoute", "GIG", and "GoInfoGame".
# The `--app-filter` flag overrides this setting, while `--no-app-filter`
# disables it:
#
WS_APP_FILTER=

# We use this path to load the .env file if we didn't pass `--env-file`:
#
WS_ENV_FILE=
